{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/bookings/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/bookings/[reference]/resend/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/contact/route.ts": {
      "maxDuration": 20
    },
    "src/app/api/payments/cashfree/order/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/payments/cashfree/return/route.ts": {
      "maxDuration": 45
    },
    "src/app/api/payments/cashfree/webhook/route.ts": {
      "maxDuration": 45
    },
    "src/app/api/payments/razorpay/verify/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/payments/razorpay/webhook/route.ts": {
      "maxDuration": 30
    }
  }
}
