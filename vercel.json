  "framework": "nextjs",
  "regions": [
    "bom1"
  ],
  "functions": {
    "src/app/api/bookings/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/bookings/[reference]/resend/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/contact/route.ts": {
