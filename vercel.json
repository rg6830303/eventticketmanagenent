    "src/app/api/payments/razorpay/verify/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/payments/razorpay/webhook/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/payments/session/route.ts": {
      "maxDuration": 30
    }
  }
}
