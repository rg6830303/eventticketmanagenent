# ---------------------------------------------------------------------------
# Houz of Vybe — environment template
# Copy to .env.local for local dev; set the same keys in Vercel → Settings →
# Environment Variables for preview/production. Never commit the filled file.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Public origin of the deployment. Used in emails, QR links and canonical URLs.
NEXT_PUBLIC_SITE_URL="https://houzofvybe.com"
NODE_ENV="development"

# --- Database (Postgres: Neon, Supabase, RDS, ...) --------------------------
# Use the POOLED connection string on Vercel (serverless opens many clients).
DATABASE_URL="postgresql://user:password@host:5432/houzofvybe?sslmode=require"
# Optional: set to "false" only for a local Postgres without TLS.
DATABASE_SSL="true"

# --- Ticket signing ---------------------------------------------------------
# HMAC key that signs every QR payload. 64 hex chars. Rotating it invalidates
# every already-issued ticket, so rotate only between events.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TICKET_SIGNING_SECRET="replace-with-64-hex-chars"

# --- Admin console host -----------------------------------------------------
# Comma-separated hostnames on which the console replaces the site entirely.
# On any OTHER host, /admin and /api/admin return 404 rather than a login page.
# Add a custom domain here if you point one at the console.
ADMIN_HOSTNAMES="hovadmin.vercel.app"

# --- Admin console auth -----------------------------------------------------
# Signs the admin session cookie (JWT). Generate the same way as above.
ADMIN_SESSION_SECRET="replace-with-64-hex-chars"
# Session lifetime in hours.
ADMIN_SESSION_HOURS="12"
# Bootstrap admin, created by `npm run admin:create`.
ADMIN_BOOTSTRAP_EMAIL="ops@houzofvybe.com"
ADMIN_BOOTSTRAP_PASSWORD="set-a-strong-password-then-delete-this-line"

# --- Email delivery (Gmail SMTP) --------------------------------------------
# Gmail requires an App Password (16 chars, no spaces) with 2FA enabled on the
# account: https://myaccount.google.com/apppasswords
# Your normal Gmail password will NOT work.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="tickets@houzofvybe.com"
SMTP_PASSWORD="your-16-char-gmail-app-password"
MAIL_FROM_NAME="Houz of Vybe"
MAIL_FROM_ADDRESS="tickets@houzofvybe.com"
MAIL_REPLY_TO="support@houzofvybe.com"
# Blind-copy every ticket email to ops for an audit trail. Optional.
MAIL_BCC=""

# --- Payments (Cashfree) ----------------------------------------------------
# The live checkout. Get the pair from Cashfree Dashboard -> Developers ->
# API Keys. A production secret starts cfsk_ma_prod_, a sandbox one
# cfsk_ma_test_ -- the app infers which host to call from that prefix, so
# CASHFREE_ENV only needs setting to override it.
#
# PAYMENTS_ENABLED defaults to ON whenever a gateway is configured, so pasting
# these two keys is enough to go live. Set it to "false" to hold the checkout
# closed with the keys still in place.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
# "production" | "sandbox". Leave blank to infer from the secret key prefix.
CASHFREE_ENV=""
# Optional override: "cashfree" | "razorpay" | "none". Leave blank and the app
# picks whichever gateway actually has keys.
PAYMENT_PROVIDER=""

# Webhooks are signed with CASHFREE_SECRET_KEY -- there is no separate secret to
# configure. In Cashfree Dashboard -> Developers -> Webhooks add:
#   URL:    https://<your-domain>/api/payments/cashfree/webhook
#   Events: PAYMENT_SUCCESS_WEBHOOK, PAYMENT_FAILED_WEBHOOK
# This is the safety net for a customer who pays and then closes the tab before
# the browser is redirected back.

# --- Payments (Razorpay, legacy rail) ---------------------------------------
# Set PAYMENTS_ENABLED=true in Vercel once the Razorpay account is live. With it
# on, a booking is created as `pending`, the customer is sent to
# /pay/<reference>, and the passes are minted only after the payment signature
# verifies. With it off, bookings confirm immediately and nothing is charged.
#
# Get the keys from Razorpay Dashboard → Settings → API Keys. Use the rzp_test_
# pair until you have tested a full checkout, then swap in the rzp_live_ pair.
PAYMENTS_ENABLED=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Webhook signing secret. In Razorpay Dashboard → Settings → Webhooks add:
#   URL:    https://<your-domain>/api/payments/razorpay/webhook
#   Event:  payment.captured
# and paste the secret you set there here. This is the safety net for a customer
# who pays and then closes the tab before the browser confirms.
RAZORPAY_WEBHOOK_SECRET=""

# --- Direct UPI collection (manual reconciliation) --------------------------
# An alternative to Razorpay for operators without a live gateway. The customer
# scans a QR for the exact amount, pays from their own UPI app, and types the
# 12-digit UTR back into the checkout.
#
# IMPORTANT: a UTR cannot be verified in software. Submitting one does NOT
# confirm a booking — it queues the order in the admin console, and an operator
# releases the passes after finding the payment in their bank or UPI app. Leave
# UPI_ENABLED=false unless somebody is actually going to watch that queue.
UPI_ENABLED="false"
UPI_VPA="sh.kavyansh@hdfcbank"
UPI_PAYEE_NAME="Kavyansh"

# --- Booking policy ---------------------------------------------------------
MAX_TICKETS_PER_BOOKING="6"
# Referral codes are rows in the referral_codes table, not env vars. Seed the
# first one with `npm run db:seed`, or insert more directly:
#   INSERT INTO referral_codes (code, label, discount_paise)
#   VALUES ('SOMECODE', 'Who it belongs to', 10000);
# Reject obviously undeliverable addresses by checking the domain has MX records.
VERIFY_EMAIL_MX="true"

# --- Ops --------------------------------------------------------------------
# Comma-separated list. Used by /api/health and the admin footer.
APP_ENV="development"
